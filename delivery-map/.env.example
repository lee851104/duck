# Server-only. Never use VITE_ for these secrets.
GOOGLE_ROUTES_API_KEY=
GOOGLE_STATIC_MAPS_API_KEY=
# Maps JS browser key is intentionally delivered to the browser. Restrict its
# HTTP referrer to the website and API scope to Maps JavaScript API only.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MONTHLY_LIMIT=9000
GOOGLE_MAPS_DAILY_LIMIT=250
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GOOGLE_MONTHLY_LIMIT=9000
GOOGLE_DAILY_LIMIT=250
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-car
